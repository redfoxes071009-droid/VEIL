weapon_name = "차원 검"
weapon_desc = "허공을 베어 포털을 여는 검. 그녀의 검으로 공간을 찢을 수 있습니다."
profile = "페이즈는 차원 이동의 힘을 해킹으로 조작해 포털을 열 수 있는 능력을 가지고 있으며,\n그녀의 검으로 공간을 찢을 수 있습니다.\n이 능력을 통해 페이즈는 재빠르게 움직이며 전투를 발휘합니다."
trait_desc = "페이즈는 차원 칼날로 포털을 열어 적을 감전시키고 [광속 질주]로 스킬을 다시 사용합니다. 궁극기 '차원 질주'는 포털 게이지를 소모해 아군 전체의 이동 속도와 공격 속도를 높이고 주변 적의 내성을 낮춥니다."
