attack_range = 28
attack_interval = 0.7
basic_mult = 0.7
skill_name = "차원 개방"
skill_desc = "페이즈가 전방에 차원 칼날을 휘둘러 허공에 포털을 개방하며 감전 전도 피해를 줍니다.\n발동 시 [광속 질주] 상태가 활성화됩니다. [광속 질주] 상태가 활성화되어 있을 시, 페이즈의 이동 속도가 증가하고 스킬 쿨다운이 초기화됩니다.\n적중 시 적 이동 속도 -20%\n피해량: 공격 속도 수치의 35%"
skill_cooldown = 6
ult_name = "차원 질주"
ult_desc = "발동 시 페이즈가 포털 게이지를 초당 3pt씩 소모하여 [질주] 상태에 진입합니다. [질주] 상태에서 페이즈는 아군에게 이동 속도 보너스 20%, 공격 속도 보너스 15%, 내성 감소 20%의 버프를 획득합니다."
