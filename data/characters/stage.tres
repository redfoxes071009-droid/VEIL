weapon_name = "듀얼 핸드건 세트"
weapon_desc = "해킹 코드를 탄환에 실어 쏘는 쌍권총. 적중 시 전도 피해를 줍니다."
profile = "스테이지는 적에게 스킬을 적중시켜 악성코드를 퍼뜨리고 전도 피해와 콤보 스택을 축적해 폭발적인 데미지를 넣는 하이퍼캐리 딜러입니다.\n스택을 쌓을수록 공격 속도가 가속하며, 최종적으로 콤보를 소모해 광역 해킹 폭발을 일으켜 전장을 장악합니다."
trait_desc = "스테이지는 스킬 적중 시 주변 적에게 악성코드가 전염되어 추가 피해를 입힙니다. 기본 스킬 '콤보!'는 적중 시 콤보 스택을 쌓아 공격 속도를 증가시키고 전도 피해 보너스를 부여합니다. 궁극기 '크래킹'은 모든 스택을 소모하여 광역 전도 피해를 입히며 마지막 일격으로 추가 피해를 줍니다."
