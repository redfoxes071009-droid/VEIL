skill_name = "콤보! (COMBO!)"
skill_desc = "스테이지가 스킬 적중 시 전도 피해를 입히며 콤보 스택을 1pt 획득합니다. (최대 5pt)\n적중 시 전도 피해 보너스 +20% (5초, 중첩 불가)\n각 콤보 1개당 공격 속도 +5% (최대 +25%)\n스택 지속 시간: 5초 (지속 중 갱신 가능)"
