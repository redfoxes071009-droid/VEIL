ult_name = "크래킹 (CRACKING)"
ult_desc = "발동 시 스테이지가 콤보 스택을 모두 소모하여 광역 전도 피해를 입힙니다.\n스택 1개당 전도 속성 해킹 추가 확산 (최대 5pt)\n성공적으로 스택을 쌓아 궁극기를 발동 시, 마지막 일격 - 픽셀 폭발을 발동합니다. (소모 스택 × 공격력 30% 추가 피해)"
