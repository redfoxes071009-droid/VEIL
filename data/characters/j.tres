weapon_name = "소음 권총"
weapon_desc = "그림자 속에서 쓰는 소음 권총. 은신 상태에서 사거리가 늘어납니다."
profile = "J는 그림자를 활용해 은신하며 적을 암살하는 인파이터형 하이퍼캐리 원거리 딜러입니다.\nHP를 소모해 폭발적인 화력을 발휘하고, 은신 상태에서 흡혈과 강력한 추가 피해를 가합니다.\n그림자는 그녀를 늘 따라다니며, 그림자를 다양한 형태로 활용해 예측 불가한 전투를 발휘합니다."
trait_desc = "J는 그림자 장막 진입 시 은신하여 HP를 소모·회복하고, 은신 중 타겟팅되지 않습니다. 기본 스킬 '생명의 대가'는 HP를 소모해 관통 피해를 주거나 은신으로 전환해 추가 피해와 치명타 보너스를 얻습니다. 궁극기 '어둠속의 그림자'는 그림자 가시로 방어 무시 피해와 속박을 주고, 발동 후 장막에 진입합니다."
ref_level = 90
