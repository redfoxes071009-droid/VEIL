effect_hit = 3107
move_speed = 72
attack_range = 110
attack_interval = 0.8
basic_mult = 0.6
skill_name = "생명의 대가"
skill_desc = "발동 시 현재 HP의 15% 소모.\n짧은 터치 - J가 근처의 적을 관통하며 가시 피해를 줍니다.\n홀드 - J가 그림자 장막 속으로 이동 후 권총으로 은신 상태로 전환합니다 (지속 시간 20초). 은신 상태에서 기본 공격 적중 시, 공격력의 20% 추가 피해를 입힙니다. 스킬 버튼을 짧게 눌러 조기 종료할 수 있습니다.\n은신 상태: 공격 사거리 15m 증가, 치명타 확률 20% 상승."
skill_cooldown = 15
ult_name = "어둠속의 그림자"
ult_desc = "J가 바닥에서 그림자 가시를 소환해 적의 방어력을 무시하고 관통 피해를 입힙니다. 이때, 중심부에 위치한 적은 5초간 속박 상태를 유지합니다.\n발동 후 그림자 장막에 진입합니다."
